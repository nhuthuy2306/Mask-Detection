# Tên file template HTML mặc định hiển thị giao diện
HTML_TEMPLATE=index_chat.html
MODEL_PATH=mask_model.onnx
ONNX_INTRA_OP_NUM_THREADS=1
MAX_FRAME_REQUEST_MB=8
MAX_DETECTIONS_PER_FRAME=100
MAX_TRACK_SESSIONS=4
MAX_TRACKS_PER_SESSION=64
MAX_TRACK_OBSERVATIONS=6
TRACK_SESSION_TTL_SECONDS=60
TRACK_EXPIRY_SECONDS=3
BACKGROUND_WORKERS=1
BACKGROUND_MAX_PENDING_TASKS=8

# Cấu hình máy chủ web Flask (tùy chọn)
HOST=0.0.0.0
PORT=5000

# Cấu hình AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Cấu hình Supabase PostgreSQL
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?sslmode=require"

# Cấu hình Telegram Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
